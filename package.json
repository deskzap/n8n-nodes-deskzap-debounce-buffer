{
  "name": "n8n-nodes-deskzap-buffer",
  "version": "0.4.0",
  "description": "Node do n8n para buffer de mensagens com debounce (Deskzap)",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "",
  "author": {
    "name": "Deskzap Automações",
    "email": "contato@deskzap.com.br"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deskzap/n8n-nodes-deskzap-debounce-buffer.git"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "nodes": [
      "dist/nodes/DeskzapDebounceBuffer/DeskzapDebounceBuffer.node.js",
      "dist/nodes/SmartBuffer/SmartBuffer.node.js"
    ],
    "credentials": [
      "dist/credentials/RedisCredentials.credentials.js"
    ]
  },
  "devDependencies": {
    "@types/express": "^4.17.6",
    "@types/request-promise-native": "~1.0.15",
    "@typescript-eslint/parser": "~5.45",
    "eslint-plugin-n8n-nodes-base": "^1.11.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "*",
    "prettier": "^2.7.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "ioredis": "^5.3.2",
    "n8n-core": "*"
  }
}
